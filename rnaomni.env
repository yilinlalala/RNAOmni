# RNAOmni default config table (committed). Agent must not modify this file.
# Optional overlay: `.env` / `.env.local` (gitignored) — only keys that differ.
# No overlay file = use this table as-is. Do not copy this file into `.env`.
# Precedence: shell / CLI / launcher > `.env` > this file.
# OpenCode API token: `opencode auth` (~/.opencode/), not here.

# --- dataset (no overlay = main CSV pipeline) ---
RNAOMNI_ACTIVE_CSV=HEK_te_prediction_task.csv
RNAOMNI_USE_COMPARE_SPLITS=0
# Do not set RNAOMNI_COMPARE_ROOT here. Naming a split directory
# (env / --compare-root) selects the external pre-split route.

# --- runtime ---
# Overnight / encode (ViennaRNA). Overlay if you use another env.
RNAOMNI_CONDA_ENV=rnaomni
TIME_BUDGET=300
MAX_SEQ_LEN=1024
# Per-process BLAS/OpenMP/torch intra-op threads (15.4a). 0 = do not cap.
# Shell / already-exported OMP_NUM_THREADS is not overwritten.
RNAOMNI_CPU_THREADS=4
# Parallel launcher: max jobs with status==running in this git_root pool (15.4b).
# Default 9. 0 / negative = unlimited. --no-wait refuses instead of waiting.
# Not a dataset queue (not D1). python -m rnaomni.finalize is not in this pool.
RNAOMNI_MAX_RUNNING_LANES=9
# Unique-table encode chunk (15.3). Peak RAM ≈ one chunk × widest channel.
RNAOMNI_ENCODE_CHUNK=4096

# --- splits (main CSV route) ---
N_FOLDS=5
TEST_FRACTION=0.1
CLS_TRAIN_FRAC=0.7
CLS_VAL_FRAC=0.2
CLS_TEST_FRAC=0.1
CLS_MMSEQS_MIN_SEQ_ID=0.8
CLS_MMSEQS_COVERAGE=0.8

# --- sampling (HEK + COMPARE; orchestrator starts full, switches on encode timeout) ---
OVERNIGHT_HOURS=6
ENCODE_TIMEOUT_SEC=3600
SAMPLE_ROW_CAP_TRAIN=1000
COMPARE_PER_CLASS_TRAIN=10
COMPARE_PER_CLASS_EVAL=10
COMPARE_SAMPLE_SEED=0
# RNAOMNI_DATA_MODE is owned by the orchestrator (full|sample). Do not pin here.

# --- search ---
MIN_DELTA_CLASSIFICATION=3e-4
MIN_DELTA_REGRESSION=1e-3
PATIENCE=15
# Consecutive [model] discards on one named head before switching (16.4).
FRAMEWORK_PATIENCE=10
MIN_ITERATIONS=10
SAMPLE_EXPAND_PATIENCE=3

# --- agent ---
AGENT_BACKEND=opencode
OPENCODE_MODEL=opencode/deepseek-v4-flash-free
# OPENCODE_BIN=
# CURSOR_MODEL=composer-2.5
# CURSOR_API_KEY=   # only in `.env`, and only for --backend cursor
